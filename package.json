{
  "name": "shopify-perf-toolkit",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "description": "Whole-theme Shopify performance diagnosis, reviewed patches, rollback, real Lighthouse/PSI measurement and score acceptance",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "perfkit": "scripts/perfkit.mjs"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "AGENTS.md",
    "theme-code-generation",
    "CHANGELOG.md",
    "package-lock.json",
    "agents",
    "assets",
    "lib",
    "scripts",
    "references",
    "tests",
    "integrations",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "packages"
  ],
  "scripts": {
    "test": "node scripts/run_tests.mjs offline",
    "test:boundaries": "node scripts/run_tests.mjs boundaries",
    "test:lighthouse": "PYTHONPATH=scripts PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:site": "node scripts/validate_site_pipeline.mjs",
    "release": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/build_release.py --with-manifest",
    "test:execution": "node --test tests/execution.test.mjs tests/batch-integration.test.mjs tests/measure.test.mjs tests/site-verify.test.mjs tests/run-evidence.test.mjs tests/cli.test.mjs",
    "test:browser": "node scripts/run_tests.mjs browser",
    "test:shopify-p1": "node --test tests/p1-performance.test.mjs",
    "test:demand": "node --test tests/demand-engine.test.mjs",
    "test:demand-live": "node scripts/validate_demand_pipeline.mjs",
    "test:architecture": "node scripts/validate_architecture_pipeline.mjs",
    "test:improvement": "node --test tests/improvement-session.test.mjs",
    "test:improvement-live": "node scripts/validate_improvement_pipeline.mjs",
    "test:p0p1": "node --test tests/p0-p1.test.mjs",
    "test:domains": "node --test tests/domain-engine.test.mjs",
    "test:domains-browser": "PERF_KIT_BROWSER_TESTS=1 node --test --test-concurrency=1 tests/domain-browser.test.mjs",
    "test:domains-live": "node scripts/validate_domain_pipeline.mjs",
    "test:official-methods": "node --test tests/official-methods.test.mjs tests/domain-engine.test.mjs tests/improvement-session.test.mjs",
    "test:extended": "node --test tests/extended-methods.test.mjs",
    "test:extended-browser": "PERF_KIT_BROWSER_TESTS=1 node --test --test-concurrency=1 tests/extended-browser.test.mjs",
    "test:extended-live": "node scripts/validate_extended_pipeline.mjs",
    "test:section-liquid": "node --test tests/section-liquid.test.mjs",
    "test:section-liquid-browser": "PERF_KIT_BROWSER_TESTS=1 node --test --test-concurrency=1 tests/section-liquid-browser.test.mjs",
    "test:section-liquid-live": "node scripts/validate_section_liquid.mjs",
    "test:theme-workflow": "node --test tests/theme-steps.test.mjs tests/liquid-assets.test.mjs tests/resource-repair.test.mjs tests/recovery-cost.test.mjs tests/improvement-session.test.mjs",
    "test:theme-workflow-browser": "PERF_KIT_BROWSER_TESTS=1 node --test --test-concurrency=1 tests/theme-steps-browser.test.mjs",
    "test:theme-workflow-live": "node scripts/validate_theme_workflow.mjs",
    "test:recovery-cycle": "node --test tests/recovery-evidence.test.mjs tests/recovery-adaptive.test.mjs tests/formal-recovery.test.mjs tests/domain-engine.test.mjs tests/architecture-boundaries.test.mjs tests/performance-upgrade.test.mjs tests/resource-budget.test.mjs tests/formal-collection-evidence.test.mjs tests/recovery-cycle.test.mjs tests/improvement-session.test.mjs",
    "test:recovery-cycle-live": "node scripts/validate_recovery_cycle.mjs",
    "test:seo": "node --test tests/seo-toolkit.test.mjs tests/seo-repair.test.mjs tests/toolkit-split.test.mjs tests/architecture-boundaries.test.mjs",
    "release:toolkits": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/build_toolkits.py",
    "test:delivery": "node --test tests/delivery-foundation.test.mjs tests/delivery-growth.test.mjs",
    "test:delivery:browser": "PERF_KIT_BROWSER_TESTS=1 node --test --test-concurrency=1 tests/delivery-browser.test.mjs",
    "validate:delivery": "node scripts/validate_delivery.mjs",
    "test:offline": "node scripts/run_tests.mjs offline",
    "test:official": "node scripts/run_tests.mjs official",
    "test:release": "npm run test:offline && npm run test:lighthouse && npm run test:browser && npm run test:official"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@shopify/liquid-html-parser": "2.10.2",
    "acorn": "8.15.0",
    "chrome-devtools-mcp": "1.11.0",
    "lighthouse": "13.5.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.30"
  },
  "devDependencies": {
    "liquidjs": "10.30.0"
  }
}
