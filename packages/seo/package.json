{
  "name": "shopify-seo-toolkit",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "Shopify source SEO audits, reversible repairs and source verification, independent of performance scoring",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "seokit": "scripts/seokit.mjs"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "CHANGELOG.md",
    "package-lock.json",
    "agents",
    "lib",
    "scripts",
    "references",
    "assets",
    "tests",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "theme-code-generation"
  ],
  "scripts": {
    "test": "node --test tests/seo-toolkit.test.mjs tests/seo-repair.test.mjs"
  },
  "dependencies": {
    "@shopify/liquid-html-parser": "2.10.2"
  }
}
